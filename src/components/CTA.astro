---
import { Sparkles, CalendarRange } from '@lucide/astro';
---

<section class="py-20 bg-primary relative overflow-hidden z-10">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="glass-premium rounded-[40px] p-10 md:p-16 lg:p-20 relative overflow-hidden flex flex-col items-center text-center max-w-5xl mx-auto border border-accent/25 shadow-2xl">
      <!-- Background Abstract Glows inside CTA -->
      <div class="absolute -top-[50%] -left-[30%] w-[80%] h-[80%] bg-accent/15 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="absolute -bottom-[50%] -right-[30%] w-[80%] h-[80%] bg-gold/15 rounded-full blur-[100px] animate-pulse-slow" style="animation-delay: 4s;"></div>

      <!-- Sparkles Decoration -->
      <div class="absolute top-10 left-10 text-accent/20 animate-float"><Sparkles class="w-8 h-8" /></div>
      <div class="absolute bottom-10 right-10 text-gold/20 animate-float-slow"><Sparkles class="w-6 h-6" /></div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-light mb-6">
        <span class="text-[10px] md:text-xs font-sans tracking-[0.25em] uppercase text-accent-light font-medium">Lugares Limitados Semanales</span>
      </div>

      <!-- Title -->
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl tracking-wide text-secondary font-light mb-6 max-w-3xl leading-[1.15]">
        Regalate el cuidado <br class="hidden sm:inline" />
        <span class="text-gradient-rose italic font-normal">que tus manos merecen.</span>
      </h2>

      <!-- Description -->
      <p class="font-sans text-secondary-muted text-base md:text-lg tracking-wide font-light max-w-2xl leading-relaxed mb-10">
        Trabajamos bajo un esquema de citas programadas con tiempos extendidos para garantizar la máxima precisión de nuestros diseños y un servicio verdaderamente libre de prisa.
      </p>

      <!-- Action Button -->
      <a 
        href="#contacto" 
        class="inline-flex items-center justify-center gap-3 px-10 py-5 rounded-full bg-gradient-to-r from-accent to-accent-dark text-primary font-sans text-xs tracking-[0.2em] uppercase font-bold shadow-2xl shadow-accent/20 hover:shadow-accent/40 hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 group"
      >
        <CalendarRange class="w-4 h-4 text-primary group-hover:rotate-6 transition-transform" />
        <span>Agendar Mi Turno Online</span>
      </a>

      <!-- Subtext / Reassurance info -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mt-10 text-xs text-secondary-muted font-light">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> Cancelación flexible hasta 24hs antes
        </span>
        <span class="hidden sm:inline text-secondary-muted/30">|</span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> Sin cargo por retiro de set previo AURA
        </span>
      </div>
    </div>
  </div>
</section>
