---
import { MapPin, Phone, Mail, Clock, Sparkles, Send } from '@lucide/astro';
---

<section id="contacto" class="py-24 bg-primary-light relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      
      <!-- Left Column: Contact Info & Map -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-12">
        <div class="space-y-6">
          <div class="flex items-center gap-2">
            <span class="w-8 h-[1px] bg-accent"></span>
            <span class="text-xs font-sans tracking-[0.25em] uppercase text-accent font-medium">Ubicación & Citas</span>
          </div>
          
          <h2 class="font-serif text-4xl md:text-5xl tracking-wide text-secondary font-light">
            Visitá nuestro <br />
            <span class="text-gradient-rose italic font-normal">atelier de arte.</span>
          </h2>
          
          <p class="font-sans text-secondary-muted text-sm md:text-base font-light leading-relaxed">
            Te esperamos en un ambiente de total privacidad en Palermo Soho. Recordá que atendemos exclusivamente con cita programada para asegurar tu tiempo y tranquilidad.
          </p>

          <!-- Contact items list -->
          <div class="space-y-5 pt-4">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0 mt-0.5">
                <MapPin class="w-4 h-4" />
              </div>
              <div>
                <p class="font-sans text-xs uppercase tracking-wider text-secondary-muted font-medium">Dirección</p>
                <p class="font-sans text-sm text-secondary font-light mt-0.5">Av. del Libertador 1420, Palermo Soho, CABA</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0 mt-0.5">
                <Phone class="w-4 h-4" />
              </div>
              <div>
                <p class="font-sans text-xs uppercase tracking-wider text-secondary-muted font-medium">WhatsApp</p>
                <p class="font-sans text-sm text-secondary font-light mt-0.5">+54 9 11 2345-6789</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0 mt-0.5">
                <Mail class="w-4 h-4" />
              </div>
              <div>
                <p class="font-sans text-xs uppercase tracking-wider text-secondary-muted font-medium">Email</p>
                <p class="font-sans text-sm text-secondary font-light mt-0.5">hola@auranails.com</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center text-accent flex-shrink-0 mt-0.5">
                <Clock class="w-4 h-4" />
              </div>
              <div>
                <p class="font-sans text-xs uppercase tracking-wider text-secondary-muted font-medium">Horario de Atención</p>
                <p class="font-sans text-sm text-secondary font-light mt-0.5">Lunes a Sábados: 10:00 a 20:00 hs.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Simulated Map / Premium aesthetic visual representation -->
        <div class="relative rounded-3xl overflow-hidden h-[240px] border border-secondary/5 group">
          <!-- Dark Elegant Grayscale Google Map integration (Simulated / Embed iframe with styles or standard static elegant block) -->
          <div class="absolute inset-0 bg-primary-card flex flex-col justify-center items-center p-6 text-center">
            <div class="w-12 h-12 rounded-full bg-accent/15 flex items-center justify-center border border-accent/30 animate-pulse mb-3">
              <MapPin class="w-5 h-5 text-accent" />
            </div>
            <p class="font-serif text-lg text-secondary tracking-wide font-light">AURA NAIL ATELIER</p>
            <p class="font-sans text-xs text-secondary-muted mt-1">Frente a Plaza Alemania, Palermo</p>
            
            <!-- Styled visual placeholder map lines -->
            <div class="w-full h-8 flex gap-1 items-center justify-center mt-6 opacity-30">
              <div class="h-[1px] bg-secondary/30 w-1/3"></div>
              <div class="w-2 h-2 rounded-full bg-accent"></div>
              <div class="h-[1px] bg-secondary/30 w-1/3"></div>
            </div>

            <a 
              href="https://maps.google.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="mt-4 font-sans text-[10px] tracking-widest uppercase text-accent hover:text-accent-light hover:underline transition-all"
            >
              Ver en Google Maps
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Booking Form -->
      <div class="lg:col-span-7">
        <div class="glass-premium rounded-[32px] p-8 md:p-10 border border-accent/15 shadow-xl relative">
          <!-- Top shining line -->
          <div class="absolute top-0 left-10 right-10 h-[1px] bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>
          
          <div class="flex items-center gap-3 mb-8">
            <Sparkles class="w-5 h-5 text-accent animate-pulse" />
            <h3 class="font-serif text-2xl tracking-wide text-secondary font-light">Solicitar Reserva</h3>
          </div>

          <!-- Contact Form with JS Interactivity -->
          <form id="booking-form" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Name Input -->
              <div class="flex flex-col space-y-2">
                <label for="name" class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-medium">Nombre Completo *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  placeholder="Tu nombre y apellido"
                  class="w-full bg-primary/40 border border-secondary/10 rounded-xl px-4 py-3 text-sm text-secondary placeholder-secondary-muted/40 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300"
                />
              </div>

              <!-- Phone/WhatsApp Input -->
              <div class="flex flex-col space-y-2">
                <label for="phone" class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-medium">WhatsApp / Teléfono *</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required
                  placeholder="Ej: +54 9 11 1234 5678"
                  class="w-full bg-primary/40 border border-secondary/10 rounded-xl px-4 py-3 text-sm text-secondary placeholder-secondary-muted/40 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Service Selection -->
              <div class="flex flex-col space-y-2">
                <label for="service" class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-medium">Servicio Deseado *</label>
                <select 
                  id="service" 
                  name="service" 
                  required
                  class="w-full bg-primary-card border border-secondary/10 rounded-xl px-4 py-3 text-sm text-secondary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300 appearance-none cursor-pointer"
                >
                  <option value="" disabled selected class="text-secondary-muted/50">Seleccioná un servicio</option>
                  <option value="Manicura Rusa" class="bg-primary-card text-secondary">Manicura Rusa Combinada ($45.000)</option>
                  <option value="Esculpidas Gel" class="bg-primary-card text-secondary">Esculpidas Soft Gel / Acrygel ($62.000)</option>
                  <option value="Nail Art Minimal" class="bg-primary-card text-secondary">Nail Art Editorial & Minimal (Desde $15.000)</option>
                  <option value="Ritual Spa" class="bg-primary-card text-secondary">Ritual Spa Regenerador ($28.000)</option>
                </select>
              </div>

              <!-- Preferred Date/Time -->
              <div class="flex flex-col space-y-2">
                <label for="datetime" class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-medium">Fecha y Hora Preferida *</label>
                <input 
                  type="datetime-local" 
                  id="datetime" 
                  name="datetime" 
                  required
                  class="w-full bg-primary/40 border border-secondary/10 rounded-xl px-4 py-3 text-sm text-secondary focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300"
                />
              </div>
            </div>

            <!-- Notes or specifications -->
            <div class="flex flex-col space-y-2">
              <label for="notes" class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-medium">Preferencias o Comentarios (Opcional)</label>
              <textarea 
                id="notes" 
                name="notes" 
                rows="3"
                placeholder="¿Tenés esmalte previo para retirar? ¿Buscás algún diseño de nail art específico?"
                class="w-full bg-primary/40 border border-secondary/10 rounded-xl px-4 py-3 text-sm text-secondary placeholder-secondary-muted/40 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300 resize-none"
              ></textarea>
            </div>

            <!-- Booking policies acknowledgment checkbox -->
            <div class="flex items-start gap-3 pt-2">
              <input 
                type="checkbox" 
                id="terms" 
                name="terms" 
                required 
                class="mt-1 accent-accent rounded border-secondary/10"
              />
              <label for="terms" class="font-sans text-xs text-secondary-muted font-light leading-relaxed select-none cursor-pointer">
                Comprendo la <a href="/cancelacion" target="_blank" class="text-accent hover:underline">política de cancelación de 24 horas</a> y que mi cita será confirmada vía WhatsApp por el atelier.
              </label>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-accent to-accent-dark text-primary font-sans text-xs tracking-[0.2em] uppercase font-bold shadow-lg shadow-accent/15 hover:shadow-xl hover:shadow-accent/25 hover:scale-[1.01] active:scale-[0.99] transition-all duration-300 group cursor-pointer"
            >
              <Send class="w-4 h-4 text-primary group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
              <span>Solicitar Turno</span>
            </button>
          </form>

          <!-- Success Message Modal Overlay -->
          <div 
            id="success-overlay" 
            class="absolute inset-0 bg-primary/95 rounded-[32px] backdrop-blur-md flex flex-col justify-center items-center p-8 text-center opacity-0 pointer-events-none transition-all duration-500 z-20"
          >
            <div class="w-16 h-16 rounded-full bg-accent/20 border border-accent/40 flex items-center justify-center text-accent animate-bounce mb-6">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            
            <h4 class="font-serif text-3xl text-gradient-rose tracking-wide font-light mb-3">¡Solicitud Enviada!</h4>
            
            <p class="font-sans text-secondary-muted text-sm max-w-md leading-relaxed mb-8">
              Gracias, <span id="success-client-name" class="text-secondary font-medium"></span>. Tu solicitud de turno para <strong id="success-service-name" class="text-accent-light"></strong> ha sido registrada con éxito.
            </p>
            
            <p class="font-sans text-xs text-secondary-muted/80 leading-relaxed mb-6">
              Te contactaremos por WhatsApp en los próximos minutos para confirmar tu fecha, hora y ultimar detalles del diseño.
            </p>

            <button 
              id="success-close-btn" 
              class="px-8 py-3 rounded-full border border-secondary/15 bg-secondary/[0.02] hover:bg-secondary/[0.05] font-sans text-[10px] tracking-widest uppercase font-bold text-secondary transition-all"
            >
              Volver al formulario
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const successOverlay = document.getElementById('success-overlay');
  const successClientName = document.getElementById('success-client-name');
  const successServiceName = document.getElementById('success-service-name');
  const successCloseBtn = document.getElementById('success-close-btn');

  if (form && successOverlay) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Retrieve form values
      const nameInput = document.getElementById('name') as HTMLInputElement;
      const serviceSelect = document.getElementById('service') as HTMLSelectElement;
      const phoneInput = document.getElementById('phone') as HTMLInputElement;
      const datetimeInput = document.getElementById('datetime') as HTMLInputElement;
      const notesInput = document.getElementById('notes') as HTMLTextAreaElement;

      const clientName = nameInput ? nameInput.value : 'Cliente';
      const serviceName = serviceSelect ? serviceSelect.value : 'el servicio';

      // Insert names into overlay content
      if (successClientName) successClientName.textContent = clientName;
      if (successServiceName) successServiceName.textContent = serviceName;

      // Show success modal overlay
      successOverlay.classList.remove('opacity-0', 'pointer-events-none');
      successOverlay.classList.add('opacity-100');

      // OPTIONAL / ADVANCED INTEGRATION: Send structured WhatsApp message automatically
      // We can generate a WhatsApp API link with prefilled text! Let's do that!
      const waNumber = "5491123456789"; // The fake salon's WhatsApp
      const dateText = datetimeInput ? datetimeInput.value : '';
      const notesText = notesInput ? notesInput.value : '';
      
      const message = `Hola Aura Nail Atelier! Me gustaría solicitar un turno:
• Nombre: ${clientName}
• Teléfono: ${phoneInput ? phoneInput.value : ''}
• Servicio: ${serviceName}
• Fecha/Hora: ${dateText}
• Notas: ${notesText}`;

      const encodedMessage = encodeURIComponent(message);
      const waLink = `https://wa.me/${waNumber}?text=${encodedMessage}`;

      // Open whatsapp link in new tab after a brief delay so they see the success overlay first
      setTimeout(() => {
        window.open(waLink, '_blank');
      }, 1500);
    });
  }

  // Close Success overlay
  if (successCloseBtn && successOverlay && form) {
    successCloseBtn.addEventListener('click', () => {
      successOverlay.classList.remove('opacity-100');
      successOverlay.classList.add('opacity-0', 'pointer-events-none');
      form.reset();
    });
  }
</script>
