---
import { Sparkles, Clock, CircleDollarSign, Check } from '@lucide/astro';

const services = [
  {
    id: 'russian-manicure',
    title: 'Manicura Rusa Combinada',
    subtitle: 'Nuestra especialidad insígnia',
    description: 'Técnica de alta precisión con torno para una limpieza impecable de cutículas, nivelación de la base con base rubber y esmaltado semipermanente bajo cutícula para máxima duración (hasta 4 semanas).',
    price: '$45.000',
    duration: '90 min',
    highlights: ['Limpieza profunda e indolora', 'Nivelación con base premium', 'Esmaltado de alta definición', 'Exfoliación e hidratación final']
  },
  {
    id: 'sculpted-gel',
    title: 'Esculpidas en Soft Gel o Acrygel',
    subtitle: 'Sutileza, largo y resistencia',
    description: 'Extensiones ultraligeras y naturales con cápsulas de gel o modeladas artesanalmente con acrygel. Ideal para corregir imperfecciones o lucir un largo sofisticado sin dañar la uña natural.',
    price: '$62.000',
    duration: '120 min',
    highlights: ['Extensiones ultraligeras', 'Aspecto 100% natural', 'Alta resistencia a impactos', 'Esmaltado semipermanente incluido']
  },
  {
    id: 'nail-art-minimal',
    title: 'Nail Art Editorial & Minimal',
    subtitle: 'Arte diseñado para vos',
    description: 'Diseño de autor hecho a mano alzada. Líneas finas, espacio negativo, texturas orgánicas, pan de oro, efecto cromo o detalles geométricos delicados para convertir tus manos en lienzos de colección.',
    price: 'Desde $15.000',
    duration: '30+ min',
    highlights: ['Diseños 100% personalizados', 'Pincelería fina a mano alzada', 'Accesorios de lujo (pan de oro/chrome)', 'Asesoría de estilo y paleta']
  },
  {
    id: 'hand-spa',
    title: 'Ritual Spa Regenerador',
    subtitle: 'Nutrición y desconexión absoluta',
    description: 'Un ritual de bienestar profundo para tus manos. Incluye exfoliación orgánica con semillas, mascarilla térmica ultra-nutritiva, masaje relajante con aceites esenciales y tratamiento restaurador de cutículas.',
    price: '$28.000',
    duration: '45 min',
    highlights: ['Exfoliación orgánica botánica', 'Baño de parafina o mascarilla', 'Masaje terapéutico hasta el codo', 'Nutrición intensa de cutículas']
  }
];
---

<section id="servicios" class="py-24 bg-primary relative overflow-hidden">
  <!-- Background Glows -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[40%] right-[-10%] w-96 h-96 bg-accent/3 rounded-full blur-[100px] animate-pulse-slow"></div>
    <div class="absolute bottom-[20%] left-[-10%] w-96 h-96 bg-gold/3 rounded-full blur-[100px] animate-pulse-slow" style="animation-delay: 3s;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <!-- Header Section -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2">
        <span class="w-8 h-[1px] bg-accent"></span>
        <span class="text-xs font-sans tracking-[0.25em] uppercase text-accent font-medium">Experiencias Exclusivas</span>
        <span class="w-8 h-[1px] bg-accent"></span>
      </div>
      <h2 class="font-serif text-4xl md:text-5xl tracking-wide text-secondary font-light">
        Nuestra carta de <span class="text-gradient-rose italic font-normal">servicios de autor</span>
      </h2>
      <p class="font-sans text-secondary-muted text-base tracking-wide font-light max-w-xl">
        Ofrecemos un menú enfocado en la salud de tus uñas y la sofisticación del diseño. Todo bajo una atmósfera de calma y cuidado riguroso.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      {services.map((service, index) => (
        <div 
          class="glass-premium rounded-3xl p-8 md:p-10 flex flex-col justify-between hover:scale-[1.01] hover:border-accent/30 transition-all duration-500 group relative overflow-hidden"
          style={`animation-delay: ${index * 0.15}s;`}
        >
          <!-- Subtle top light -->
          <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-accent/25 to-transparent"></div>
          
          <div>
            <!-- Header of Card -->
            <div class="flex justify-between items-start gap-4 mb-6">
              <div>
                <span class="text-xs font-sans text-accent-light tracking-widest uppercase font-medium block mb-1">{service.subtitle}</span>
                <h3 class="font-serif text-2xl md:text-3xl tracking-wide text-secondary font-light group-hover:text-accent transition-colors duration-300">
                  {service.title}
                </h3>
              </div>
              <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:rotate-12 transition-transform duration-500">
                <Sparkles class="w-5 h-5 text-accent" />
              </div>
            </div>

            <!-- Description -->
            <p class="font-sans text-secondary-muted text-sm font-light leading-relaxed mb-8">
              {service.description}
            </p>

            <!-- Highlights checklist -->
            <div class="space-y-3 mb-8">
              <p class="text-[10px] uppercase tracking-[0.15em] text-secondary font-medium mb-4">¿Qué incluye el servicio?</p>
              {service.highlights.map(highlight => (
                <div class="flex items-center gap-3">
                  <div class="w-4 h-4 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center flex-shrink-0">
                    <Check class="w-2.5 h-2.5 text-accent" />
                  </div>
                  <span class="font-sans text-xs text-secondary-muted/90 font-light">{highlight}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Footer of Card (Price & Book) -->
          <div class="pt-6 border-t border-secondary/5 flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-4">
            <div class="flex items-center gap-4">
              <div class="flex items-center gap-1.5 text-secondary">
                <Clock class="w-4 h-4 text-accent/80" />
                <span class="font-sans text-xs font-light tracking-wide">{service.duration}</span>
              </div>
              <div class="flex items-center gap-1 text-secondary">
                <CircleDollarSign class="w-4 h-4 text-gold/80" />
                <span class="font-serif text-lg text-gradient-gold tracking-wide">{service.price}</span>
              </div>
            </div>
            
            <a 
              href="#contacto" 
              class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-secondary/[0.03] border border-secondary/10 hover:border-accent hover:bg-accent hover:text-primary font-sans text-[10px] tracking-[0.2em] uppercase font-bold text-secondary transition-all duration-300"
            >
              Agendar Turno
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Extra Quality Assurance Note -->
    <div class="mt-16 glass rounded-2xl p-6 text-center max-w-2xl mx-auto border border-accent/10">
      <p class="font-sans text-xs text-secondary-muted/90 font-light leading-relaxed">
        <strong class="text-accent">Aviso Importante:</strong> Para todos los servicios de uñas esculpidas o esmaltado semipermanente, realizamos un retiro cuidadoso libre de costo del set previo colocado en nuestro atelier. Retiros de otros establecimientos tienen un recargo adicional de $5.000.
      </p>
    </div>
  </div>
</section>
