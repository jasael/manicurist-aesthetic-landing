---
import { Sparkles, ArrowRight } from '@lucide/astro';
---

<footer class="bg-primary pt-20 pb-10 border-t border-secondary/5 relative overflow-hidden z-10">
  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16">
      
      <!-- Column 1: Brand Info & Socials -->
      <div class="md:col-span-4 flex flex-col items-start space-y-6">
        <a href="/" class="flex items-center gap-2 group">
          <Sparkles class="w-5 h-5 text-accent group-hover:rotate-12 transition-transform duration-300" />
          <span class="font-serif text-2xl tracking-[0.15em] text-gradient-rose font-medium">AURA</span>
          <span class="text-xs font-sans tracking-[0.3em] uppercase text-secondary-muted/80 ml-1 mt-1">Nail Atelier</span>
        </a>
        <p class="font-sans text-secondary-muted text-xs leading-relaxed max-w-sm">
          Un santuario dedicado al cuidado minucioso y al diseño minimalista en Palermo Soho, Buenos Aires. Transformamos tus manos en una declaración de elegancia silenciosa.
        </p>
        
        <!-- Social Icons -->
        <div class="flex items-center gap-4 pt-2">
          <!-- Instagram -->
          <a 
            href="https://instagram.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Seguinos en Instagram"
            class="w-9 h-9 rounded-full border border-secondary/10 flex items-center justify-center text-secondary hover:text-accent hover:border-accent/40 hover:bg-accent/5 transition-all duration-300"
          >
            <svg class="w-4 h-4 fill-none stroke-current" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <!-- TikTok / Pinterest represented elegantly -->
          <a 
            href="https://tiktok.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Seguinos en TikTok"
            class="w-9 h-9 rounded-full border border-secondary/10 flex items-center justify-center text-secondary hover:text-accent hover:border-accent/40 hover:bg-accent/5 transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.89-.6-4.09-1.5-1.12-.85-1.92-2.1-2.26-3.48-.02 1.98-.01 3.97-.02 5.95 0 2.2-.42 4.49-1.74 6.22-1.46 1.92-3.86 3.01-6.27 2.91-2.43-.09-4.83-1.43-5.94-3.59-1.28-2.52-1.02-5.83.74-8.03 1.5-1.89 4.03-2.82 6.42-2.38V8.3c-1.33-.24-2.85.08-3.79 1.07-.98 1.04-1.17 2.72-.55 3.98.59 1.19 1.94 1.99 3.27 1.95 1.55-.05 2.94-1.2 3.14-2.73.12-1 .04-2.01.06-3.02C12.525 6.3 12.525 3.16 12.525.02z"/>
            </svg>
          </a>
          <a 
            href="https://pinterest.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Seguinos en Pinterest"
            class="w-9 h-9 rounded-full border border-secondary/10 flex items-center justify-center text-secondary hover:text-accent hover:border-accent/40 hover:bg-accent/5 transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="md:col-span-2 md:col-start-6 flex flex-col items-start space-y-4">
        <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-semibold">Navegación</p>
        <div class="flex flex-col space-y-2.5 font-sans text-xs text-secondary-muted font-light">
          <a href="#inicio" class="hover:text-accent transition-colors duration-300">Inicio</a>
          <a href="#nosotros" class="hover:text-accent transition-colors duration-300">Sobre nosotros</a>
          <a href="#servicios" class="hover:text-accent transition-colors duration-300">Servicios</a>
          <a href="#opiniones" class="hover:text-accent transition-colors duration-300">Opiniones</a>
          <a href="#contacto" class="hover:text-accent transition-colors duration-300">Reserva</a>
        </div>
      </div>

      <!-- Column 3: Legal Links -->
      <div class="md:col-span-2 flex flex-col items-start space-y-4">
        <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-semibold">Políticas & Legal</p>
        <div class="flex flex-col space-y-2.5 font-sans text-xs text-secondary-muted font-light">
          <a href="/privacidad" class="hover:text-accent transition-colors duration-300">Política de Privacidad</a>
          <a href="/terminos" class="hover:text-accent transition-colors duration-300">Términos de Servicio</a>
          <a href="/cancelacion" class="hover:text-accent transition-colors duration-300">Política de Cancelación</a>
        </div>
      </div>

      <!-- Column 4: Newsletter -->
      <div class="md:col-span-3 flex flex-col items-start space-y-4">
        <p class="font-sans text-[10px] uppercase tracking-[0.2em] text-secondary font-semibold">Inspiración Semanal</p>
        <p class="font-sans text-xs text-secondary-muted leading-relaxed font-light">
          Unite a nuestro newsletter para recibir ideas de nail art, consejos de cuidado y lanzamientos de colores.
        </p>
        
        <!-- Subtle Newsletter form -->
        <form class="flex w-full items-stretch relative mt-2">
          <input 
            type="email" 
            required 
            placeholder="Tu email..."
            class="w-full bg-primary-light border border-secondary/10 rounded-full px-4 py-2.5 text-xs text-secondary placeholder-secondary-muted/40 focus:outline-none focus:border-accent transition-all duration-300"
          />
          <button 
            type="submit" 
            aria-label="Suscribirse"
            class="absolute right-1 top-1 bottom-1 px-4 rounded-full bg-accent hover:bg-accent-light text-primary flex items-center justify-center transition-all cursor-pointer"
          >
            <ArrowRight class="w-3.5 h-3.5" />
          </button>
        </form>
      </div>

    </div>

    <!-- Divider -->
    <div class="w-full h-[1px] bg-secondary/5 mb-10"></div>

    <!-- Bottom subfooter -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-6 text-center">
      <p class="font-sans text-[10px] uppercase tracking-widest text-secondary-muted/60 font-light">
        © 2026 AURA Nail Atelier. Todos los derechos reservados.
      </p>
      
      <p class="font-sans text-[10px] uppercase tracking-widest text-secondary-muted/60 font-light">
        Hecho con amor en Palermo Soho, Buenos Aires.
      </p>
    </div>
  </div>
</footer>
