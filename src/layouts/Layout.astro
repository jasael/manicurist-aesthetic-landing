---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonicalURL?: string;
	ogImage?: string;
}

const { 
	title, 
	description, 
	canonicalURL = Astro.url.href, 
	ogImage = '/images/og-image.jpg' 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.url).href} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(ogImage, Astro.url).href} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-primary text-secondary antialiased selection:bg-accent/30 selection:text-white min-h-screen flex flex-col overflow-x-hidden font-sans">
		<!-- Background Decorative Glows -->
		<div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
			<div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-accent/5 blur-[120px] animate-pulse-slow"></div>
			<div class="absolute bottom-[-10%] right-[-10%] w-[50vw] h-[50vw] rounded-full bg-gold/5 blur-[120px] animate-pulse-slow" style="animation-delay: 3s;"></div>
		</div>

		<!-- Main Content Slot -->
		<main class="flex-grow z-10">
			<slot />
		</main>

		<!-- Subtle Interactive Custom Glow (Optional & Modern) -->
		<div id="mouse-glow" class="hidden md:block fixed w-[400px] h-[400px] rounded-full bg-accent-light/3 pointer-events-none blur-[100px] transform -translate-x-1/2 -translate-y-1/2 transition-opacity duration-500 opacity-0 z-0"></div>

		<script>
			// Interactive mouse glow for premium modern feel
			const glow = document.getElementById('mouse-glow');
			if (glow) {
				window.addEventListener('mousemove', (e) => {
					glow.style.left = `${e.clientX}px`;
					glow.style.top = `${e.clientY}px`;
					glow.style.opacity = '1';
				});
				
				document.addEventListener('mouseleave', () => {
					glow.style.opacity = '0';
				});
			}
		</script>
	</body>
</html>
